{
  "expo": {
    "name": "Shelf Circle",
    "slug": "shelf-circle",
    "scheme": "shelfcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelfcircle.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shelfcircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shelf Circle uses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shelf Circle uses your camera to scan a friend's invite QR code."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a15d1a8-fa2a-4d72-b8f2-a149ce95626f"
      }
    },
    "owner": "culpeo-labs"
  }
}
