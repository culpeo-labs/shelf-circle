# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* vars at build time —
# restart `expo start` after changing this file.

# The shelf-circle backend, e.g. http://localhost:8080 for a local run, or
# http://<your-lan-ip>:8080 when testing on a physical device via Expo Go
# (localhost on the device means the device itself, not your dev machine).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Hanko Cloud project API URL (Hanko dashboard -> your project -> API URL).
# The backend's HANKO_API_URL must point at the same project. Enable "Passcode"
# (email code) as a login method in the project's settings — this app drives
# whatever login flow the project is configured for, but was built against a
# passcode/email-code setup.
EXPO_PUBLIC_HANKO_API_URL=https://REPLACE_ME.hanko.io
