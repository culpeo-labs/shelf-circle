# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* vars at build time —
# restart `expo start` after changing this file.

# The shelf-circle backend. Either:
#   - the deployed prod API (simplest — no local backend/DB to run):
#     https://shelfcircle-prod-api.proudwave-73a3907d.westus.azurecontainerapps.io
#     (this points the app at real prod data — fine for now at friends-scale,
#     but worth remembering once this stops being just a testing app)
#   - a local run: http://localhost:8080, or http://<your-lan-ip>:8080 when
#     testing on a physical device via Expo Go (localhost on the device means
#     the device itself, not your dev machine)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Hanko Cloud project API URL (Hanko dashboard -> your project -> API URL).
# The backend's HANKO_API_URL must point at the same project. Enable "Passcode"
# (email code) as a login method in the project's settings — this app drives
# whatever login flow the project is configured for, but was built against a
# passcode/email-code setup.
#
# The project already used in prod is the `HANKO_API_URL` GitHub Actions
# variable (environment: prod) — `gh variable list --env prod`.
EXPO_PUBLIC_HANKO_API_URL=https://REPLACE_ME.hanko.io
